# Array combinators and ambient Array methods. Method policy is written in Aven;
# `flatMap` collection and the primitive operations are evaluator natives.
# Ambient methods load through the trusted standard-library root without
# entering user scope. Import this module only for the residual producer
# `range`. The evaluator's native `flatMap` appends callback arrays into one
# backing vector; array-producing methods share it as their linear collector.
# Helpers are module-private (local recursion is not bound in the checker).
#
# Traversal terminates on `index < xs.length()`, not on an indexed
# `undefined`. Indexing past the end yields `undefined`, which is
# indistinguishable from a stored `undefined` element of an `Array(?T)`,
# so index-until-undefined would silently truncate (and would fail to match
# a stored `null` of an `Array(T?)`). In-bounds `xs[index]` is the element.

# Own recursive helper so a hit returns without scanning the rest.
findGo : (Array(a), Int, (a) -> Bool) -> ?a
findGo = (xs, index, pred) =>
  index < xs.length() ?>
    true =>
      element: a = xs[index]
      pred(element) ?>
        true => element
        false => findGo(xs, index + 1, pred)
    false => undefined

# Own recursive helper so a hit returns without scanning the rest.
# Membership via `[element].has(target)` (same PartialEq as `Array.has`) so a
# stored empty compared with a non-empty target is false, not a kind error —
# Aven `==` rejects cross-kind pairs such as `undefined` vs `Int`.
indexOfGo : (Array(a), Int, a) -> ?Int
indexOfGo = (xs, index, target) =>
  index < xs.length() ?>
    true =>
      element: a = xs[index]
      [element].has(target) ?>
        true => index
        false => indexOfGo(xs, index + 1, target)
    false => undefined

# Half-open `[start, end)`; omitting `end` slices through to the end. Negative
# indexes wrap from the end first (`length + v`), then both ends clamp to
# `[0, length]`. After wrap+clamp, `start >= end` → `[]`. Partially/fully out of
# range → only what is in range.
# Examples (xs length 3): `xs.slice(1)` → all but first; `xs.slice(0, -1)` → all
# but last; `xs.slice(-2, 99)` → last two; `xs.slice(3, 2)` → `[]`.
clampIndex : (Int, Int) -> Int
clampIndex = (i, n) =>
  zero: Int = 0
  i < zero ?>
    true => zero
    false =>
      i > n ?>
        true => n
        false => i

# Wrap negative `i` from the end, then clamp into `[0, n]`.
normalizeSliceIndex : (Int, Int) -> Int
normalizeSliceIndex = (i, n) =>
  zero: Int = 0
  wrapped =
    i < zero ?>
      true => n + i
      false => i
  clampIndex(wrapped, n)

# Find where `x` belongs so equals stay before it (stable).
insertIndexGo : (Array(a), Int, a, (a, a) -> Bool) -> Int
insertIndexGo = (sorted, index, x, isLess) =>
  index < sorted.length() ?>
    true =>
      y: a = sorted[index]
      isLess(x, y) ?>
        true => index
        false => insertIndexGo(sorted, index + 1, x, isLess)
    false => index

insertSorted : (Array(a), a, (a, a) -> Bool) -> Array(a)
insertSorted = (sorted, x, isLess) =>
  at = insertIndexGo(sorted, 0, x, isLess)
  Array.range(0, sorted.length() + 1).flatMap((index) =>
    index == at ?>
      true => [x]
      false =>
        sourceIndex: Int = index < at ?> true => index, false => index - 1
        [sorted[sourceIndex]]
  )

# Stable insertion sort. `isLess(a, b)` is true when `a` sorts strictly before `b`.
sortWithGo : (Array(a), Int, Array(a), (a, a) -> Bool) -> Array(a)
sortWithGo = (xs, index, sorted, isLess) =>
  index < xs.length() ?>
    true =>
      element: a = xs[index]
      inserted = insertSorted(sorted, element, isLess)
      sortWithGo(xs, index + 1, inserted, isLess)
    false => sorted


# Drop every `undefined` and `null` element. Used by specialized `compact`
# owners that peel one empty wrapper from the element type
# (`Array(?a) -> Array(a)`, `Array(a?) -> Array(a)`). Bodies drop both empties
# because runtime ambient dispatch keys only on the owner head (`Array`), not
# the type argument — the first installed body runs for every compact call.
# For `Array(?a?)`, call `compact` twice to peel both wrappers.
# Own recursive helper so a hit returns without scanning the rest.
findIndexGo : (Array(a), Int, (a) -> Bool) -> ?Int
findIndexGo = (xs, index, pred) =>
  index < xs.length() ?>
    true =>
      element: a = xs[index]
      pred(element) ?>
        true => index
        false => findIndexGo(xs, index + 1, pred)
    false => undefined

Ordered = {
  <(Self): Bool
  ..
}

minGo : (Array(t), Int, t) -> t
minGo = (xs: Array(t), index: Int, best: t): t
  t: Ordered
=>
  index < xs.length() ?>
    true =>
      item: t = xs[index]
      item < best ?>
        true => minGo(xs, index + 1, item)
        false => minGo(xs, index + 1, best)
    false => best

maxGo : (Array(t), Int, t) -> t
maxGo = (xs: Array(t), index: Int, best: t): t
  t: Ordered
=>
  index < xs.length() ?>
    true =>
      item: t = xs[index]
      best < item ?>
        true => maxGo(xs, index + 1, item)
        false => maxGo(xs, index + 1, best)
    false => best

Array(a) {
  # `length()` is a language native on Array (backing `Vec` size), same path as
  # `push` / `has` / `joinWith`.

  isEmpty(): Bool =>
    zero: Int = 0
    .length() == zero

  first(): ?a => .[0]

  # Empty: `.[-1]` wraps to -1 → still out-of-bounds `undefined`.
  # Non-empty: negative index wraps from the end (`-1` is last).
  last(): ?a => .[-1]

  each(f: (a) -> ()): () => .fold((), (acc, x) => f(x))

  count(pred: (a) -> Bool): Int =>
    zero: Int = 0
    .fold(zero, (acc, x) => pred(x) ?> true => acc + 1, false => acc)

  all(pred: (a) -> Bool): Bool =>
    start: Bool = true
    .fold(start, (acc, x) => acc && pred(x))

  any(pred: (a) -> Bool): Bool =>
    start: Bool = false
    .fold(start, (acc, x) => acc || pred(x))

  find(pred: (a) -> Bool): ?a => findGo(., 0, pred)

  # Index of the first element matching `pred`, or `undefined` when none match.
  # Prefer this over `find` when the element type already admits `undefined`
  # (`Array(?T)`): a found empty and a miss are indistinguishable in `?a`.
  findIndex(pred: (a) -> Bool): ?Int => findIndexGo(., 0, pred)

  indexOf(target: a): ?Int =>
    zero: Int = 0
    indexOfGo(., zero, target)

  map(f: (a) -> b): Array(b) =>
    xs = .
    xs.flatMap((x) => [f(x)])

  flatMap(f: (a) -> Array(b)): Array(b) =>
    # Evaluator dispatch resolves this native collector before ambient lookup.
    xs = .
    xs.flatMap(f)

  filter(pred: (a) -> Bool): Array(a) =>
    xs = .
    xs.flatMap((x) => pred(x) ?> true => [x], false => [])

  reverse(): Array(a) =>
    xs = .
    n = xs.length()
    Array.range(0, n).flatMap((index) => [xs[n - index - 1]])

  concat(other: Array(a)): Array(a) =>
    xs = .
    [..xs, ..other]

  take(n: Int): Array(a) =>
    xs = .
    end = clampIndex(n, xs.length())
    Array.range(0, end).flatMap((index) => [xs[index]])

  drop(n: Int): Array(a) =>
    xs = .
    start = clampIndex(n, xs.length())
    Array.range(start, xs.length()).flatMap((index) => [xs[index]])

  slice(start: Int, end: ?Int = undefined): Array(a) =>
    n = .length()
    s = normalizeSliceIndex(start, n)
    e = normalizeSliceIndex(end ?? n, n)
    count = s < e ?> true => e - s, false => 0
    xs = .
    Array.range(0, count).flatMap((index) => [xs[s + index]])

  zip(other: Array(b)): Array((a, b)) =>
    xs = .
    n = xs.length() < other.length() ?> true => xs.length(), false => other.length()
    Array.range(0, n).flatMap((index) => [(xs[index], other[index])])

  sortWith(isLess: (a, a) -> Bool): Array(a) =>
    seed: Array(a) = []
    sortWithGo(., 0, seed, isLess)

  # Ascending by projected key. Stable via `sortWith` (equal keys keep input order).
  sortBy(key: (a) -> k): Array(a)
    k: Ordered
  =>
    .sortWith((left, right) => key(left) < key(right))

  minimum(): ?a
    a: Ordered
  =>
    n = .length()
    zero: Int = 0
    n == zero ?>
      true => undefined
      false =>
        first: a = .[0]
        minGo(., 1, first)

  maximum(): ?a
    a: Ordered
  =>
    n = .length()
    zero: Int = 0
    n == zero ?>
      true => undefined
      false =>
        first: a = .[0]
        maxGo(., 1, first)
}

Array(Int) {
  sum(): Int =>
    zero: Int = 0
    .fold(zero, (acc, x) => acc + x)
}

Array(Array(a)) {
  flatten(): Array(a) =>
    xss = .
    xss.flatMap((xs) => xs)
}


Array(?a) {
  compact(): Array(a) =>
    xs = .
    xs.flatMap((element) =>
      element ?>
        undefined => []
        null => []
        value => [value]
    )
}

Array(a?) {
  compact(): Array(a) =>
    xs = .
    xs.flatMap((element) =>
      element ?>
        undefined => []
        null => []
        value => [value]
    )
}

{}
