# Typed CLI specifications: `cli = import("std/cli")`.
# Build once with `cli.define({ verbose: cli.flag(), ... })`, then call
# `cli.parse(spec, args)`. Decoders determine the exact output field types.
# Aliases are full spellings (e.g. "--chatty"); `short: "v"` adds "-v".

# Value domains are explicit metadata, never inferred from a decoder. This
# vocabulary can grow with Files/Dirs/Values without changing the command tree.
ValueCompletion = @{ @Unspecified }
Meta = { name: Text, names: Array(Text), takesValue: Bool, help: Text, valueName: Text, valueCompletion: ValueCompletion }
Completion = @{ @Opaque, @Options(Array(Meta)), @Commands(Array(CommandMeta)) }

int = (raw: Text): Result(Int, Text) =>
  raw.toInt() ?>
    undefined => @Err("expected an integer, got '${raw}'")
    value => @Ok(value)

text = (raw: Text): Result(Text, Text) => @Ok(raw)

metadata = (name: Text, takesValue: Bool, config): Meta =>
  aliases: Array(Text) = []
  m = { short: "", help: "", valueName: "VALUE", aliases, ..config }
  short: Array(Text) = m.short == "" ?> true => [], false => ["-${m.short}"]
  { name, names: ["--${name}", ..short, ..m.aliases], takesValue, help: m.help, valueName: m.valueName, valueCompletion: @Unspecified }

flag = (config: { .. } = {}) => {
  meta: (name: Text) => metadata(name, false, config),
  read: (tokens: Map(Text, Text), name: Text): Result(Bool, Text) =>
    @Ok((tokens.get(name) ?? "false") == "true")
}

option = (decode: (Text) -> Result(a, Text), config: { default: a, .. }) => {
  meta: (name: Text) => metadata(name, true, config),
  read: (tokens: Map(Text, Text), name: Text): Result(a, Text) =>
    tokens.get(name) ?>
      undefined => @Ok(config.default)
      raw => decode(raw) ?>
        @Ok(value) => @Ok(value)
        @Err(message) => @Err("--${name}: ${message}")
}

required = (decode: (Text) -> Result(a, Text), config: { .. } = {}) => {
  meta: (name: Text) => metadata(name, true, config),
  read: (tokens: Map(Text, Text), name: Text): Result(a, Text) =>
    tokens.get(name) ?>
      undefined => @Err("--${name} is required")
      raw => decode(raw) ?>
        @Ok(value) => @Ok(value)
        @Err(message) => @Err("--${name}: ${message}")
}

# Every token is consumed once. An option's separate value is consumed with it,
# even when that value resembles a flag. Attached values retain every '='.
# Repetition is an error; positionals and short bundles are not supported yet.
tokenizeGo : (Array(Meta), Array(Text), Int, Map(Text, Text)) -> Result(Map(Text, Text), Text)
tokenizeGo = (options, argv, index, tokens) =>
  index >= argv.length() ?>
    true => @Ok(tokens)
    false =>
      word = argv[index] ?? ""
      word == "--" ?>
        true => index + 1 == argv.length() ?>
          true => @Ok(tokens)
          false => @Err("unexpected positional argument '${argv[index + 1] ?? ""}'")
        false =>
          head = word.splitOn("=")[0] ?? ""
          options.find((m) => m.names.has(head)) ?>
            undefined => @Err("unknown argument '${head}'")
            m =>
              tokens.get(m.name) ?>
                undefined =>
                  m.takesValue ?>
                    false => word.contains("=") ?>
                      true => @Err("${head} does not take a value")
                      false => tokenizeGo(options, argv, index + 1, tokens.set(m.name, "true"))
                    true => word.contains("=") ?>
                      true => tokenizeGo(options, argv, index + 1, tokens.set(m.name, word.dropPrefix("${head}=")))
                      false => argv[index + 1] ?>
                        undefined => @Err("${head} needs a value")
                        "--" => @Err("${head} needs a value")
                        raw => tokenizeGo(options, argv, index + 2, tokens.set(m.name, raw))
                _ => @Err("${head} was supplied more than once")

tokenize : (Array(Meta), Array(Text)) -> Result(Map(Text, Text), Text)
tokenize = (options, argv) =>
  seed: Map(Text, Text) = Map.empty()
  tokenizeGo(options, argv, 0, seed)

renderHelp = (options: Array(Meta), info): Text =>
  examples: Array(Text) = []
  m = { name: "tool", description: "", examples, ..info }
  lines = options.map((o) =>
    value = o.takesValue ?> true => " <${o.valueName}>", false => ""
    "  ${o.names.joinWith(", ")}${value}  ${o.help}"
  )
  exampleText = m.examples.isEmpty() ?>
    true => ""
    false => "\n\nExamples:\n${m.examples.map((e) => "  ${e}").joinWith("\n")}"
  "Usage: ${m.name} [options]\n${m.description}\n\nOptions:\n${lines.joinWith("\n")}${exampleText}"

# Capture the static key set and normalize metadata at definition time. Calling
# the returned parser allocates only token data and the typed result record.
define = (schema: s, info: { .. } = {}, @keys = keysOf(schema)) =>
  options = valuesOf({ keys -> key; (key, schema[key].meta(key)) })
  usage = renderHelp(options, info)
  completion: Completion = @Options(options)
  {
    completion,
    help: usage,
    helpFor: (_: Array(Text)): Text => usage,
    parse: (argv: Array(Text)) =>
      result = (() =>
        tokens = tokenize(options, argv)?^
        @Ok({ keys -> key; (key, schema[key].read(tokens, key)?^) })
      )()
      result ?>
        @Ok(value) => @Ok(value)
        @Err(message) => @Err("${message}\n\n${usage}")
  }

parse = (spec, argv: Array(Text)) => spec.parse(argv)
help = (spec, argv: Array(Text) = []) => spec.helpFor(argv)

CommandMeta = { names: Array(Text), help: Text, child: Completion }

# The explicit constructor supplies the tag; its payload is inferred from the
# child parser. This avoids inventing a type name from a command's spelling.
command = (spec: { parse: (Array(Text)) -> Result(a, Text), helpFor: (Array(Text)) -> Text, .. }, wrap: (a) -> b, config: { .. } = {}) =>
  aliases: Array(Text) = []
  m: { aliases: Array(Text), help: Text } = { aliases, help: "", ..config }
  child: Completion = { completion: @Opaque, ..spec }.completion
  {
    meta: (name: Text): CommandMeta => { names: [name, ..m.aliases], help: m.help, child }
    helpFor: spec.helpFor
    parse: (argv: Array(Text)) => @Ok(wrap(spec.parse(argv)?^))
  }

renderCommandHelp = (commands: Array(CommandMeta), info): Text =>
  examples: Array(Text) = []
  m = { name: "tool", description: "", examples, ..info }
  lines = commands.map((c) => "  ${c.names.joinWith(", ")}  ${c.help}")
  exampleText = m.examples.isEmpty() ?>
    true => ""
    false => "\n\nExamples:\n${m.examples.map((e) => "  ${e}").joinWith("\n")}"
  "Usage: ${m.name} <command> [options]\n${m.description}\n\nCommands:\n${lines.joinWith("\n")}${exampleText}"

# Parser functions have the same argv input, and their closed tagged results
# join into one variant. Every branch retains its command-specific payload.
app = (commands: s, info: { .. } = {}, @keys = keysOf(commands)) =>
  details = valuesOf({ keys -> key; (key, commands[key].meta(key)) })
  parsers = valuesOf({ keys -> key; (key, commands[key].parse) })
  helps = valuesOf({ keys -> key; (key, commands[key].helpFor) })
  usage = renderCommandHelp(details, info)
  completion: Completion = @Commands(details)
  {
    completion
    help: usage
    helpFor: (argv: Array(Text)): Text =>
      head = argv[0] ?? ""
      details.findIndex((m) => m.names.has(head)) ?>
        undefined => usage
        index => helps[index] ?>
          undefined => usage
          child => child(argv.drop(1))
    parse: (argv: Array(Text)) =>
      head = argv[0] ?? ""
      details.findIndex((m) => m.names.has(head)) ?>
        undefined => @Err("unknown command '${head}'\n\n${usage}")
        index => parsers[index] ?>
          undefined => @Err("unknown command '${head}'\n\n${usage}")
          child => child(argv.drop(1))
  }




# Completion generators consume data only. Shell scripts never launch the tool.
# Flattening happens on the explicit generation call, not during define/parse.
CompletionRow = { id: Text, node: Completion }
completionRows : (Completion, Text) -> Array(CompletionRow)
completionRows = (node, id) =>
  children: Array(CompletionRow) = node ?>
    @Commands(commands) => Array.range(0, commands.length()).flatMap((i) =>
      child: CommandMeta = commands[i]
      completionRows(child.child, "${id}_${i}")
    )
    _ => []
  [{ id, node }, ..children]

bashQuote = (value: Text): Text => "'${value.replaceEach("'", "'\\''")}'"
fishQuote = (value: Text): Text => "'${value.replaceEach("\\", "\\\\").replaceEach("'", "\\'")}'"

# Escape every ASCII character, including underscores, to make names injective.
# Non-ASCII characters are not bash metacharacters; fish names are also quoted.
completionFunction = (program: Text): Text =>
  ascii = "\u{0}\u{1}\u{2}\u{3}\u{4}\u{5}\u{6}\u{7}\u{8}\u{9}\u{a}\u{b}\u{c}\u{d}\u{e}\u{f}\u{10}\u{11}\u{12}\u{13}\u{14}\u{15}\u{16}\u{17}\u{18}\u{19}\u{1a}\u{1b}\u{1c}\u{1d}\u{1e}\u{1f} !\"#\$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~\u{7f}"
  "__aven_${program.chars().map((c) => ascii.indexOf(c) ?> undefined => c, i => "_${i}_").joinWith("")}"

bashPattern = (names: Array(Text)): Text => names.map(bashQuote).joinWith("|")
fishNames = (names: Array(Text)): Text => names.map(fishQuote).joinWith(" ")

# fish treats -c as a pattern and older releases unescape it again. Keep the
# pattern simple; the generated condition checks the literal executable name.
fishProgramPattern = (program: Text): Text =>
  safe = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-."
  program.chars().map((c) => safe.contains(c) ?> true => c, false => "*").joinWith("")

bashTransitions = (row: CompletionRow): Array(Text) =>
  body: Array(Text) = row.node ?>
    @Opaque => ["        return 0"]
    @Commands(commands) => [
      "        case \"$word\" in",
      ..Array.range(0, commands.length()).map((i) =>
        item: CommandMeta = commands[i]
        "          ${bashPattern(item.names)}) state=${row.id}_${i} ;;"
      ),
      "          *) return 0 ;;", "        esac"
    ]
    @Options(options) => [
      ..bashOptionsStartLines(),
      ..Array.range(0, options.length()).map((i) =>
        entry: Meta = options[i]
        takes = entry.takesValue ?> true => "1", false => "0"
        "          ${bashPattern(entry.names)}) key=${row.id}_${i}; takes=${takes} ;;"
      ),
      ..bashOptionsEndLines()
    ]
  ["      ${row.id})", ..body, "        ;;"]

bashCandidates = (row: CompletionRow): Array(Text) =>
  body: Array(Text) = row.node ?>
    @Opaque => []
    @Commands(commands) => ["      candidates=(${commands.flatMap((c) => c.names).map(bashQuote).joinWith(" ")})"]
    @Options(options) => Array.range(0, options.length()).flatMap((i) =>
      entry: Meta = options[i]
      [
        "      key=${row.id}_${i}; takes=0",
        "      for item in \"\${seen[@]}\"; do [[ $item == \"$key\" ]] && takes=1; done",
        "      ((takes)) || candidates+=(${entry.names.map(bashQuote).joinWith(" ")})"
      ]
    )
  ["    ${row.id})", ..body, "      ;;"]

bashCompletions = (rows: Array(CompletionRow), program: Text, function: Text): Text =>
  [
    "# Generated by Aven std/cli. Source this file in bash.",
    "${function}() {",
    ..bashStartLines(),
    ..rows.flatMap(bashTransitions),
    "    esac", "  done", "  ((pending)) && return 0",
    "  case \"$state\" in",
    ..rows.flatMap(bashCandidates),
    "  esac",
    "  for item in \"\${candidates[@]}\"; do",
    "    [[ $item == \"$cur\"* ]] && COMPREPLY+=(\"$item\")",
    "  done", "  return 0", "}",
    "complete -F ${function} -- ${bashQuote(program)}", ""
  ].joinWith("\n")

fishTransitions = (row: CompletionRow): Array(Text) =>
  body: Array(Text) = row.node ?>
    @Opaque => ["        return 1"]
    @Commands(commands) => [
      ..Array.range(0, commands.length()).flatMap((i) =>
        item: CommandMeta = commands[i]
        prefix = i == 0 ?> true => "if", false => "else if"
        ["        ${prefix} contains -- \"$word\" ${fishNames(item.names)}", "          set state ${row.id}_${i}"]
      ),
      ..(commands.isEmpty() ?> true => ["        return 1"], false => ["        else", "          return 1", "        end"])
    ]
    @Options(options) => [
      ..fishOptionsStartLines(),
      ..Array.range(0, options.length()).flatMap((i) =>
        entry: Meta = options[i]
        prefix = i == 0 ?> true => "if", false => "else if"
        takes = entry.takesValue ?> true => "1", false => "0"
        ["        ${prefix} contains -- \"$head\" ${fishNames(entry.names)}", "          set key ${row.id}_${i}", "          set takes ${takes}"]
      ),
      ..(options.isEmpty() ?> true => ["        return 1"], false => ["        else", "          return 1", "        end"]),
      ..fishOptionsEndLines()
    ]
  ["      case ${row.id}", ..body]

fishDeclarations = (row: CompletionRow, program: Text, function: Text): Array(Text) =>
  base = "complete -c ${fishQuote(fishProgramPattern(program))}"
  condition = "${fishQuote(function)} ${row.id}"
  row.node ?>
    @Opaque => []
    @Commands(commands) => commands.flatMap((c) => c.names.map((name) =>
      # -a is evaluated a second time by fish when completing. Quote twice.
      "${base} -n ${fishQuote(condition)} -a ${fishQuote(fishQuote(name))} -d ${fishQuote(c.help)}"
    ))
    @Options(options) => Array.range(0, options.length()).flatMap((i) =>
      entry: Meta = options[i]
      entry.names.map((name) =>
        spelling = name.startsWith("--") ?>
          true => "-l ${fishQuote(name.dropPrefix("--"))}"
          false => name.startsWith("-") ?>
            true => "-o ${fishQuote(name.dropPrefix("-"))}"
            false => "-a ${fishQuote(fishQuote(name))}"
        value = entry.takesValue ?> true => " -x", false => ""
        "${base} -n ${fishQuote("${condition} ${row.id}_${i}")} ${spelling}${value} -d ${fishQuote(entry.help)}"
      )
    )

fishCompletions = (rows: Array(CompletionRow), program: Text, function: Text): Text =>
  [
    "# Generated by Aven std/cli. Source this file in fish.",
    "function ${fishQuote(function)}",
    "  set -l words (commandline -opc)",
    "  set -l executable (string split -r -m 1 / -- \"$words[1]\")[-1]",
    "  test \"$executable\" = ${fishQuote(program)}; or return 1",
    "  test (count $argv) = 0; and return 0",
    ..fishStartLines(),
    ..rows.flatMap(fishTransitions),
    ..fishEndLines(),
    "complete -c ${fishQuote(fishProgramPattern(program))} -n ${fishQuote(fishQuote(function))} -f",
    ..rows.flatMap((row) => fishDeclarations(row, program, function)), ""
  ].joinWith("\n")

completions = (spec: { completion: Completion, .. }, shell: "bash" | "fish", program: Text): Text =>
  rows = completionRows(spec.completion, "n")
  function = completionFunction(program)
  shell ?>
    "bash" => bashCompletions(rows, program, function)
    "fish" => fishCompletions(rows, program, function)

bashStartLines = (): Array(Text) =>
  [
    "  local LC_ALL=C",
    "  local line=\${COMP_LINE:0:COMP_POINT} word='' quote='' ch next cur state=n pending=0 key takes item",
    "  local escaped=0 started=0 i",
    "  local -a words=() seen=() candidates=()",
    "  COMPREPLY=()",
    "  # Read literal shell words without executing expansions. COMP_WORDS splits '='.",
    "  for ((i=0; i<\${#line}; i++)); do",
    "    ch=\${line:i:1}",
    "    if ((escaped)); then",
    "      [[ $ch == $'\\n' ]] || word+=\"$ch\"",
    "      escaped=0",
    "      continue",
    "    fi",
    "    case \"$quote\" in",
    "      \"'\")",
    "        if [[ $ch == \"'\" ]]; then quote=''; else word+=\"$ch\"; fi ;;",
    "      '\"')",
    "        case \"$ch\" in",
    "          '\"') quote='' ;;",
    "          '\\')",
    "            next=\${line:i+1:1}",
    "            case \"$next\" in",
    "              '$'|'`'|'\"'|'\\'|$'\\n') escaped=1 ;;",
    "              *) word+=\"$ch\" ;;",
    "            esac ;;",
    "          *) word+=\"$ch\" ;;",
    "        esac ;;",
    "      '')",
    "        case \"$ch\" in",
    "          \"'\"|'\"') quote=$ch; started=1 ;;",
    "          '\\') escaped=1; started=1 ;;",
    "          ' '|$'\\t'|$'\\n')",
    "            if ((started)); then words+=(\"$word\"); word=''; started=0; fi ;;",
    "          *) word+=\"$ch\"; started=1 ;;",
    "        esac ;;",
    "    esac",
    "  done",
    "  cur=$word",
    "  for ((i=1; i<\${#words[@]}; i++)); do",
    "    word=\${words[i]}",
    "    if ((pending)); then",
    "      [[ $word == -- ]] && return 0",
    "      pending=0",
    "      continue",
    "    fi",
    "    case \"$state\" in"
  ]

bashOptionsStartLines = (): Array(Text) =>
  [
    "        [[ $word == -- ]] && return 0",
    "        key='' takes=0",
    "        case \"\${word%%=*}\" in"
  ]

bashOptionsEndLines = (): Array(Text) =>
  [
    "          *) return 0 ;;",
    "        esac",
    "        for item in \"\${seen[@]}\"; do [[ $item == \"$key\" ]] && return 0; done",
    "        seen+=(\"$key\")",
    "        if [[ $word == *=* ]]; then",
    "          ((takes)) || return 0",
    "        elif ((takes)); then",
    "          pending=1",
    "        fi"
  ]

fishStartLines = (): Array(Text) =>
  [
    "  set -l state n",
    "  set -l pending 0",
    "  set -l seen",
    "  for word in $words[2..-1]",
    "    if test $pending = 1",
    "      test \"$word\" = --; and return 1",
    "      set pending 0",
    "      continue",
    "    end",
    "    switch \"$state\""
  ]

fishOptionsStartLines = (): Array(Text) =>
  [
    "        test \"$word\" = --; and return 1",
    "        set -l head (string split -m 1 '=' -- \"$word\")[1]",
    "        set -l key ''",
    "        set -l takes 0"
  ]

fishOptionsEndLines = (): Array(Text) =>
  [
    "        contains -- \"$key\" $seen; and return 1",
    "        set -a seen \"$key\"",
    "        if string match -q '*=*' -- \"$word\"",
    "          test $takes = 1; or return 1",
    "        else if test $takes = 1",
    "          set pending 1",
    "        end"
  ]

fishEndLines = (): Array(Text) =>
  [
    "    end",
    "  end",
    "  test \"$state\" = \"$argv[1]\"; or return 1",
    "  test $pending = 0; or return 1",
    "  if test (count $argv) -gt 1",
    "    contains -- \"$argv[2]\" $seen; and return 1",
    "  end",
    "  return 0",
    "end"
  ]

{ int, text, flag, option, required, define, parse, help, command, app, completions }
