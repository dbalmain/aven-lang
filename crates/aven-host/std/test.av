# Test assertions: `import("std/test")`. Pure Aven — no host natives.
# Each helper returns `Result({}, Text)` so a suite of zero-arg thunks can
# chain with `?^` and report pass/fail without host support.

# Argument order is `(actual, expected)` — the computed value first, matching
# the order `aven explain test.not-callable` teaches. Getting it backwards is
# silent: the assertion still passes or fails correctly, only the message is
# inverted. The orientation is pinned by a test with distinguishable arguments.
# Compared values are rendered with `debugText` so messages stay unambiguous:
# Text is quoted, containers keep structure, and a custom `toText` cannot make a
# failing assertion look correct. Caller-supplied messages (`fail`) stay as-is.
expectEq : (a, a) -> Result({}, Text)
expectEq = (actual, expected) =>
  actual == expected ?>
    true => @Ok({})
    false => @Err("expected ${debugText(expected)}, got ${debugText(actual)}")

expectNe : (a, a) -> Result({}, Text)
expectNe = (actual, expected) =>
  actual != expected ?>
    true => @Ok({})
    false => @Err("expected values to differ, both were ${debugText(actual)}")

# Absolute float comparison. Order is `(actual, expected, tolerance)` — same
# actual-first orientation as `expectEq`. Tolerance defaults to `1.0e-9` so the
# two-argument form works for near-exact floats. Relative tolerance is not
# offered yet; add a separate helper if a task needs it.
# No top-level `(Float, Float, Float) -> …` annotation: that form marks every
# parameter required, which would reject the defaulted two-argument call at
# check time. Param annotations + trailing default keep both arities sound.
expectApproxEq = (actual: Float, expected: Float, tolerance: Float = 1.0e-9) =>
  (actual - expected).abs() <= tolerance ?>
    true => @Ok({})
    false => @Err("expected approximately ${debugText(expected)} (tolerance ${debugText(tolerance)}), got ${debugText(actual)}")

expectOk : (Result(a, e)) -> Result({}, Text)
expectOk = (result) =>
  result ?>
    @Ok(_) => @Ok({})
    @Err(error) => @Err("expected @Ok, got @Err(${debugText(error)})")

expectErr : (Result(a, e)) -> Result({}, Text)
expectErr = (result) =>
  result ?>
    @Ok(value) => @Err("expected @Err, got @Ok(${debugText(value)})")
    @Err(_) => @Ok({})

expectTrue : (Bool) -> Result({}, Text)
expectTrue = (value) =>
  value ?>
    true => @Ok({})
    false => @Err("expected true, got false")

expectFalse : (Bool) -> Result({}, Text)
expectFalse = (value) =>
  value ?>
    true => @Err("expected false, got true")
    false => @Ok({})

fail : (Text) -> Result({}, Text)
fail = (message) => @Err(message)

pass : Result({}, Text)
pass = @Ok({})

{ expectEq, expectNe, expectApproxEq, expectOk, expectErr, expectTrue, expectFalse, fail, pass }
