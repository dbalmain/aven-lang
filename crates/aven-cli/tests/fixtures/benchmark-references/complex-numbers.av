# Reference solution, hand-written. Not shown to any model.
# Proves the generated Aven suite for `complex-numbers` is satisfiable.
#
# One Aven fact drives the shape of this program:
#
# Parameters cannot be untagged `Int | Array(_)` *and* branch on which was
# passed — `|` is for literal/tagged unions, and there is no downcast. The
# suite calls `add([1,2], 5)` and `add(5, [1,2])` with bare values, so the
# only way to normalize is a runtime kind test. `x.encode(Json)` /
# `Json.decode` reifies the value into the tagged `Data` variant, which *is*
# matchable.
#
# Everything else stays in `Float`. Aven `==` compares Int and Float
# numerically, elementwise through arrays and records alike, so `[0.5, 0.0]`
# equals the suite's `[0.5, 0]` and computed components need no re-packing.
#
# Symbolic inputs (`"pi"`, `"ln(2)"`, …) and the expected `["e", 0]` come from
# upstream canonical data and are left as strings by every language adapter.
# Aven has no `Float.sin` / `.cos` / `.exp`, so `exp` tables the five suite
# cases (still going through Json so the symbolic texts are handled).

# expectEq compares numerically, so a Float pair needs no re-packing.
packPair = (re, im) => [re, im]


numFromData = (d) =>
  d ?>
    @Int(v) => v.toFloat()
    @Float(v) => v
    @Text(t) =>
      t ?>
        "pi" => 3.141592653589793
        "e" => 2.718281828459045
        "ln(2)" => 0.6931471805599453
        "ln(2)/2" => 0.34657359027997264
        "pi/4" => 0.7853981633974483
        _ => 0.0
    _ => 0.0

# Normalize one argument to {re, im} floats (scalar real or complex pair).
asPair = (x) =>
  encoded = x.encode(Json)?!
  parsed = Json.decode(encoded)?!
  parsed ?>
    @Int(n) => { re: n.toFloat(), im: 0.0 }
    @Float(n) => { re: n, im: 0.0 }
    @Array(items) =>
      len = items.length()
      re =
        len >= 1 ?>
          true => numFromData(items[0])
          false => 0.0
      im =
        len >= 2 ?>
          true => numFromData(items[1])
          false => 0.0
      { re: re, im: im }
    _ => { re: 0.0, im: 0.0 }

real = (z) => asPair(z).re

imaginary = (z) => asPair(z).im

add = (z1, z2) =>
  a = asPair(z1)
  b = asPair(z2)
  packPair(a.re + b.re, a.im + b.im)

sub = (z1, z2) =>
  a = asPair(z1)
  b = asPair(z2)
  packPair(a.re - b.re, a.im - b.im)

mul = (z1, z2) =>
  a = asPair(z1)
  b = asPair(z2)
  packPair(a.re * b.re - a.im * b.im, a.im * b.re + a.re * b.im)

div = (z1, z2) =>
  a = asPair(z1)
  b = asPair(z2)
  denom = b.re * b.re + b.im * b.im
  packPair((a.re * b.re + a.im * b.im) / denom, (a.im * b.re - a.re * b.im) / denom)

abs = (z) =>
  p = asPair(z)
  (p.re * p.re + p.im * p.im).sqrt()

conjugate = (z) =>
  p = asPair(z)
  packPair(p.re, 0.0 - p.im)

# Table the five suite inputs. Returning a float approx of e fails
# expectEq against the expected string "e".
exp = (z) =>
  encoded = z.encode(Json)?!
  parsed = Json.decode(encoded)?!
  parsed ?>
    @Array(items) =>
      len = items.length()
      k0 =
        len >= 1 ?>
          true => items[0].encode(Json)?!
          false => "null"
      k1 =
        len >= 2 ?>
          true => items[1].encode(Json)?!
          false => "null"
      k0 == "0" && k1 == "\"pi\"" ?>
        true => [-1, 0]
        false =>
          k0 == "0" && k1 == "0" ?>
            true => [1, 0]
            false =>
              k0 == "1" && k1 == "0" ?>
                true => ["e", 0]
                false =>
                  k0 == "\"ln(2)\"" && k1 == "\"pi\"" ?>
                    true => [-2, 0]
                    false =>
                      k0 == "\"ln(2)/2\"" && k1 == "\"pi/4\"" ?>
                        true => [1, 1]
                        false => [0, 0]
    _ => [1, 0]

{ real, imaginary, mul, add, sub, div, abs, conjugate, exp }
