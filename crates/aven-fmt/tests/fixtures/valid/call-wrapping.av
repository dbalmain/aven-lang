short = combine(first, second)
long = combine("a deliberately long first argument for the wrapping policy", second, third)
normalise = combine(
                  first, second
                  )
preserve = pair(
  first,
  second)
chain = records.withAnIntentionallyLongMethodName("a deliberately long argument", second)
alreadyChained = records
  .short(first)
Constraint = @SameHouse({ a: Text, b: Text }) | @RightOf({ right: Text, left: Text }) | @Adjacent({ a: Text, b: Text }) | @AtPosition({ value: Text, position: Int })
